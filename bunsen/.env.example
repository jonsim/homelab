TZ=Europe/London
HA_DOMAIN=homeassistant.home.jonsim.com

# Create a Cloudflare API token scoped to the jonsim.com zone with
# Zone:Read and DNS:Edit permissions. Keep the real token in .env, not Git.
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# Use the same high-entropy value on Gonzo, Bunsen and Walter.
AGENT_SECRET=replace_with_long_random_portainer_agent_secret

# Bind the agent only to Bunsen's trusted LAN address. Allow TCP 9001 only from
# Gonzo in the host or network firewall.
PORTAINER_AGENT_BIND_ADDRESS=192.0.2.10
