# Copy this file to .env, replace every placeholder, and keep the result out of
# version control.
MYSQL_ROOT_PASSWORD=replace_with_database_root_password
MYSQL_DATABASE=replace_with_database_name
MYSQL_USER=replace_with_database_user
MYSQL_PASSWORD=replace_with_database_password

# Cloudflare API token used by Caddy for DNS-01 certificate challenges.
# Restrict it to Zone:Read and DNS:Edit for the jonsim.com zone.
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# Get this from the Cloudflare Zero Trust dashboard when you create
# the tunnel (Networks > Tunnels > Create a tunnel > Docker install command
# will show a token in the run command — copy just the token value)
TUNNEL_TOKEN=replace_with_tunnel_token

# Use the same high-entropy value on Gonzo, Bunsen and Walter.
AGENT_SECRET=replace_with_long_random_portainer_agent_secret
