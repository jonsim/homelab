# Create a Cloudflare API token scoped to the jonsim.com zone with
# Zone:Read and DNS:Edit permissions. Store the real token only in the
# SOPS-encrypted secrets.sops.env file.
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# Use the same high-entropy value on Gonzo, Bunsen, Walter and Scooter.
AGENT_SECRET=replace_with_long_random_portainer_agent_secret

# Full Home Assistant dashboard URL to open after the graphical session starts.
KIOSK_URL=https://homeassistant.home.jonsim.com/
